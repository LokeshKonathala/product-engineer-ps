# Server (server/.env)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incident_feed
PORT=4000
CLIENT_URL=http://localhost:5173
DEFAULT_REPLAY_LIMIT=100
MAX_REPLAY_LIMIT=500
MAX_MESSAGE_LENGTH=2000

# Client (client/.env)
VITE_API_BASE_URL=http://localhost:4000

# Server tests (server/.env.test) — point at a separate database so tests
# never touch data you're using for the manual demo.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incident_feed_test
